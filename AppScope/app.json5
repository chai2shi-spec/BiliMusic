{
  "app": {
    "bundleName": "com.chai.bilimusic",
    "vendor": "Hanversion",
    "versionCode": 1003001,
    "versionName": "1.3.1",
    // 2026-10-08 图标分层（应用市场审核要求）：改指分层描述 layered_image.json，
    // 前景 app_icon_fg / 背景 app_icon_bg 各 1024×1024，圆角由系统遮罩处理。
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    // 2026-10-25 备用图标（API 26 alternateIcons）：4 套预设设计（design/icon），
    // 运行时经 bundleManager.setAlternateIcon(name) 切换桌面图标、传 '' 恢复默认。
    // 分层组合：01/02 粉底 #FB7299，03/04 深粉底 #C2185B；仅 bundleType=app 生效。
    "alternateIcons": [
      { "name": "wave_bars", "icon": "$media:alt_icon_01" },
      { "name": "headphones", "icon": "$media:alt_icon_02" },
      { "name": "audio_ring", "icon": "$media:alt_icon_03" },
      { "name": "vinyl", "icon": "$media:alt_icon_04" }
    ]
  }
}
