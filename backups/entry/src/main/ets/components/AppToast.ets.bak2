/**
 * 全局轻提示：AppStorage 驱动的**单实例** SnackBar（Index 根部挂载一次）。
 *
 * 阶段 4 迁移：自绘气泡 → HDS 标准组件 HdsSnackBar（即时操作）。
 *   - 视觉/动效/避让（含键盘）由 HDS 统一提供，字号字色不再自管；
 *   - 保留「单实例 + 序号替换」语义：连续调用只显示最后一条，绝不排队连播
 *     （批量删 5 首只弹最后一次）。
 *
 * 通道（任何 .ts/.ets 都能写，播放内核也走这里，见 MusicPlayer.notifyHint）：
 *   STORE_TOAST_MSG      文案
 *   STORE_TOAST_HOLD_MS  停留时长（ms，即 HdsSnackBar 的 duration；
 *                        ≤0 表示常驻不自动消失）
 *   STORE_TOAST_SEQ      递增序号 —— 相同文案连续调用也要触发 @Watch（替换而非忽略）；
 *                        ⚠️ 必须读-改-写递增，独立计数器会撞号丢提示（见 Constants）
 * UI 侧统一入口 showAppToast()；组件侧订阅三键，@Watch 直接透传给 HdsSnackBar。
 *
 * ⚠️ 层级边界：bindSheet / AlertDialog 等弹层渲染在页面之上的弹层系，
 * 弹层内触发的提示仍走系统 Toast（见 QueueSheet）。
 */

import {
  HdsSnackBar,
  SnackBarIconOptions,
  SnackBarMessageOptions,
  SnackBarOperationOptions,
  SnackBarStyleOptions
} from '@kit.UIDesignKit';
import {
  STORE_TOAST_HOLD_MS,
  STORE_TOAST_MSG,
  STORE_TOAST_SEQ
} from '../common/Constants';
import { TOAST_HOLD_MS } from '../common/constants/InteractionConstants';

/**
 * 全局轻提示入口（UI 侧统一走这里）。
 * 连续调用 = 替换：seq 递增让组件重发 SnackBar 并覆盖文案，不排队。
 */
export function showAppToast(message: string, holdMs: number = TOAST_HOLD_MS): void {
  AppStorage.setOrCreate(STORE_TOAST_MSG, message);
  AppStorage.setOrCreate(STORE_TOAST_HOLD_MS, holdMs);
  const seq: number = AppStorage.get<number>(STORE_TOAST_SEQ) ?? -1;
  AppStorage.setOrCreate(STORE_TOAST_SEQ, seq + 1);
}

@Component
export struct AppToast {
  @StorageLink(STORE_TOAST_MSG) toastMsg: string = '';
  @StorageLink(STORE_TOAST_HOLD_MS) toastHoldMs: number = TOAST_HOLD_MS;
  @StorageLink(STORE_TOAST_SEQ) @Watch('onToastRequested') toastSeq: number = -1;
  /** 单实例 SnackBar：重复 show() 即替换当前气泡，天然满足「不排队」 */
  private snackBar: HdsSnackBar | null = null;

  aboutToAppear(): void {
    this.snackBar = new HdsSnackBar(this.getUIContext());
  }

  aboutToDisappear(): void {
    this.snackBar?.dismiss();
    this.snackBar = null;
  }

  /** 新请求到达：透传给 HdsSnackBar（样式区域留空 = 无图标、无操作区，纯文案） */
  private onToastRequested(): void {
    if (this.snackBar === null) {
      this.snackBar = new HdsSnackBar(this.getUIContext());
    }
    const icon: SnackBarIconOptions = {};
    const message: SnackBarMessageOptions = { title: this.toastMsg };
    const operation: SnackBarOperationOptions = {};
    const style: SnackBarStyleOptions = { duration: this.toastHoldMs };
    this.snackBar.show(icon, message, operation, style);
  }

  build() {
    // HdsSnackBar 由 UIContext 在页面之上的浮层系渲染，宿主本身不占位、不拦截触摸
    Stack() {
    }
    .width('100%')
    .height('100%')
    .hitTestBehavior(HitTestMode.None)
  }
}
