/**
 * 搜索页顶栏内容（HdsNavigation 迁移批 4，顶栏迁根容器）。
 *
 * 搜索页原 GlassTopBar 固定栏（搜索行 + 内容页签行）迁到根 HdsNavigation
 * 的 titleBar：搜索行由 Index.tabTitleBar 搜索页分支槽入（stackBuilder），
 * 内容页签行走 titleBar content 的 bottomBuilder 槽。本文件承载**带状态的栏内容**——
 *
 * - 状态：与前两页不同，搜索框 / 滑块 / 页签的**控件本体**就在根栏里，
 *   keyword / searchKind / tab 是页面与根栏共享的双向状态（两侧 @StorageLink，
 *   任一侧写入另一侧即见：页面点历史词条改词 ↔ 输入框回显；页面切页签 ↔
 *   页签行高亮）。高度键（搜索行 / 页签行实测高）由本组件 onAreaChange 回写，
 *   页面读它们定位历史面板与组让位量。
 * - 动作：经 TabScrollerHolder 静态回调转交页面私有方法（页面 aboutToAppear 注册）。
 * - 视觉：与页面原 searchBar builder 逐字一致（32vp 输入框、8vp 圆角语言、
 *   B 站粉滑片、13fp 页签 chip、44 命中区），保证「换容器不换观感」。
 * - 唯一机械适配：滑片白片平移动画原是页面 setSearchKind 里的 animateTo
 *   包裹状态写入；迁根栏后状态写入方在页面、动画节点在根栏，animateTo 跨不了
 *   这层 —— 改为白片自带 .animation（200ms EaseOut，参数一致，观感等价）。
 */

import { TabScrollerHolder } from '../service/TabScrollerHolder';
import { BUTTON_RADIUS_VP } from '../common/constants/InteractionConstants';
import { ButtonMaterialModifier, makeButtonMaterialModifier } from '../utils/HeaderBarMaterial';
import { SearchStateHolder } from '../service/SearchStateHolder';
import {
  STORE_SEARCH_KEYWORD,
  STORE_SEARCH_KIND,
  STORE_SEARCH_TAB,
  STORE_SEARCH_TABS_HEIGHT
} from '../common/Constants';

/**
 * 搜索行（Index.tabTitleBar 搜索页分支槽入，垂直居中在 56vp 标题行内）：
 * 输入框 + 类型滑块选段（视频 / UP主）+ 搜索按钮，视觉逐字克隆原 searchBar 首行。
 */
@Component
export struct SearchInputBar {
  /** 双向：根栏输入 ↔ 页面（点历史词条 / 恢复会话词）。初值取 holder 的会话词，两侧同源不打架 */
  @StorageLink(STORE_SEARCH_KEYWORD) keyword: string = SearchStateHolder.keyword;
  /** 双向：滑块选段 ↔ 页面（doSearch / 占位文案都读它） */
  @StorageLink(STORE_SEARCH_KIND) searchKind: string = 'video';
  /** 搜索按钮沉浸光感材质修饰器：26+ 生效，低版本 no-op 显实色兜底 */
  private buttonMaterial: ButtonMaterialModifier = makeButtonMaterialModifier();

  build() {
    Row() {
      // text 用 $$ 双向绑定：点历史词条是**页面改 AppStorage**，单向绑定时
      // 输入框不一定跟着刷新（用户输入侧有 $$ 回写，但外部改值没有回显路径）
      TextInput({
        placeholder: this.searchKind === 'user' ? '搜索UP主' : '搜索歌曲、歌单',
        text: $$this.keyword
      })
        .layoutWeight(1)
        // 高度与右侧滑块一致（32），圆角与按钮/滑块同一套 8vp 语言
        .height(32)
        .borderRadius(BUTTON_RADIUS_VP)
        .backgroundColor($r('app.color.bg_card'))
        .onSubmit((): void => {
          TabScrollerHolder.searchSubmit();
        })
        // 点击 / 获焦都展开历史：已获焦时再点一次不会触发 onFocus，只靠 onClick 补
        .onClick((): void => {
          TabScrollerHolder.searchOpenHistory();
        })
        .onFocus((): void => {
          TabScrollerHolder.searchOpenHistory();
        })
        .onChange((_v: string): void => {
          // $$ 已回写 keyword；这里只收历史面板，别让面板盖着结果
          TabScrollerHolder.searchCloseHistory();
        })
      // 搜索类型滑块选段（视频 / UP主，iOS segmented 式）。
      // 放在搜索框同一行而不是下方：下方是历史面板的定位区，塞东西进去会和面板打架。
      // 凹槽 bg_divider，滑片 B站粉 bili_pink 圆角 8 平移 50vp 切换段，
      // 选中文字 brand_on（与所有粉底按钮同一配色）；
      // 标签行声明在滑片之后 = 叠在滑片上层，点击落在标签上。
      // ⚠️ 白片动画见文件头注释：原 animateTo 迁移后改为自带 .animation。
      Stack({ alignContent: Alignment.Start }) {
        Column()
          .width(48)
          .height(28)
          .borderRadius(BUTTON_RADIUS_VP)
          .backgroundColor($r('app.color.bili_pink'))
          .translate({ x: this.searchKind === 'user' ? 50 : 0 })
          .animation({ duration: 200, curve: Curve.EaseOut })
        Row() {
          Text('视频')
            .fontSize(13)
            .fontColor(this.searchKind === 'user'
              ? $r('app.color.text_secondary')
              : $r('app.color.brand_on'))
            .fontWeight(this.searchKind === 'user' ? FontWeight.Normal : FontWeight.Medium)
            .width(48)
            .height(28)
            .textAlign(TextAlign.Center)
            .accessibilityText('切换到搜视频')
            .accessibilityLevel('yes')
            .onClick((): void => {
              TabScrollerHolder.searchSetKind('video');
            })
          Text('UP主')
            .fontSize(13)
            .fontColor(this.searchKind === 'user'
              ? $r('app.color.brand_on')
              : $r('app.color.text_secondary'))
            .fontWeight(this.searchKind === 'user' ? FontWeight.Medium : FontWeight.Normal)
            .width(48)
            .height(28)
            .textAlign(TextAlign.Center)
            .margin({ left: 2 })
            .accessibilityText('切换到搜 UP 主')
            .accessibilityLevel('yes')
            .onClick((): void => {
              TabScrollerHolder.searchSetKind('user');
            })
        }
      }
      .width(102)
      .height(32)
      .borderRadius(BUTTON_RADIUS_VP)
      .backgroundColor($r('app.color.bg_divider'))
      .padding(2)
      // 与搜索按钮同款 left 8：输入框↔滑块↔搜索按钮 三段间距一致
      .margin({ left: 8 })
      Button('搜索', { type: ButtonType.Normal })
        .fontSize(13)
        .height(32)
        .borderRadius(BUTTON_RADIUS_VP)
        .backgroundColor($r('app.color.bili_pink'))
        .fontColor($r('app.color.brand_on'))
        .attributeModifier(this.buttonMaterial)
        .onClick((): void => {
          TabScrollerHolder.searchSubmit();
        })
        .margin({ left: 8 })
    }
    .width('100%')
    .padding({ left: 12, right: 12, top: 8, bottom: 8 })
  }
}

/**
 * 内容页签行（搜索 / 推荐 / 排行榜 / 音乐中心，titleBar content 的 bottomBuilder 槽）。
 * 页签行实测高度经 STORE_SEARCH_TABS_HEIGHT 回写：Index 给 bottomBuilder 显式高度
 * （实测前估计值垫底）、页面组让位量，都读它（bottomBuilder 高度不自适应是官方约束，
 * 批 2 UpSpace/PD、批 4 歌单页同款模式）。
 * 行级 onClick：历史面板展开时点页签行空白处照常收起（面板在页面层，够不着根栏，
 * 原「点任意空白处收起」的触达由这条兜底；页签 chip 自身点击不冒泡到行）。
 */
@Component
export struct SearchTabsBar {
  /** 只读：选中态由页面 switchTab 写入 */
  @StorageProp(STORE_SEARCH_TAB) tab: string = 'search';
  /** 页签行实测高（vp）：onAreaChange 回写（初值 0 = 未实测） */
  @StorageLink(STORE_SEARCH_TABS_HEIGHT) searchTabsHeight: number = 0;

  build() {
    Row() {
      this.SearchTabButton('搜索', 'search')
      this.SearchTabButton('推荐', 'recommend')
      this.SearchTabButton('排行榜', 'ranking')
      this.SearchTabButton('音乐中心', 'center')
    }
    .width('100%')
    .padding({ left: 12, right: 12, bottom: 8 })
    .onClick((): void => {
      TabScrollerHolder.searchCloseHistory();
    })
    // 量出页签行真实高度：bottomBuilder 显式高度 + 页面让位量都读它
    .onAreaChange((_old: Area, cur: Area): void => {
      const h: number = cur.height as number;
      if (h > 0) {
        this.searchTabsHeight = h;
      }
    })
  }

  /**
   * 页签按钮（视觉逐字克隆页面原 TabButton）。
   * 只接收**静态字面量**参数，选中态 `this.tab === target` 在 Builder 内部现算。
   */
  @Builder
  SearchTabButton(label: string, target: string) {
    Text(label)
      .fontSize(13)
      .fontColor(this.tab === target ? $r('app.color.brand_deep') : $r('app.color.text_secondary'))
      // 触达铁律：视觉是小 chip，命中区撑到 44 高（13 号字行高 18 + 上下各 13 padding）
      .padding({ left: 14, right: 14, top: 13, bottom: 13 })
      .borderRadius(22)
      .stateStyles({
        pressed: { .backgroundColor($r('app.color.press_overlay')) },
        normal: { .backgroundColor(Color.Transparent) }
      })
      .onClick((): void => {
        TabScrollerHolder.searchSwitchTab(target);
      })
  }
}
