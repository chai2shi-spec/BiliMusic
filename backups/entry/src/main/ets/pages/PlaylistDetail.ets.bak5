/**
 * 歌单详情页：展示歌单内单曲，支持播放全部 / 单曲播放 / 加入队列 / 从歌单移除。
 * 目标歌单 id 由 NavStackHolder.selectedPlaylistId 传入。
 *
 * 标题栏为自绘（系统 NavDestination 标题栏无法去掉返回键）：
 * 无返回键（返回走系统侧滑），整体 position 到状态栏下方（y = safeTop），
 * 材质沿用沉浸光感 THIN（MaterialCompat uiMaterial 通路），列表滚动时从材质下透出。
 *
 * iOS 式大标题：列表首个 ListItem 为「封面 + 28fp 大标题 + 元信息 + 操作按钮行」
 * 头部区，随内容一起滚出视口（播放全部 / 拉取新投稿都在头部区，不钉顶部）；
 * 固定栏为纯材质条，不显示文字（歌单名只在头部区 28fp 大标题显示一次）；
 * 重命名 / 删除歌单入口在歌单列表页行内 ⋮ 菜单。
 */

// 标题栏沉浸材质（THIN 毛玻璃）走 utils/HeaderBarMaterial 的共享修饰器：
// 内部经 MaterialCompat 的版本门控访问 uiMaterial（API 23/24 静态 import 崩溃，必须 lazy）。
import { Playlist, Track, buildTrack } from '../model/MusicModels';
import { LibraryStore } from '../service/LibraryStore';
import * as BilibiliApi from '../api/BilibiliApi';
import { SpaceVideo } from '../api/BilibiliApi';
import { toHttpsUrl, stripHtmlTags, parseDurationText } from '../utils/TextUtil';
import { MusicPlayer } from '../player/MusicPlayer';
import { TrackItem } from '../components/TrackItem';
import { CoverImage } from '../components/CoverImage';
import { NavStackHolder } from '../service/NavStackHolder';
import { NAV_TITLE_BAR_HEIGHT } from '../utils/NavTitleStyle';
import { NAV_TRANSITION_MS } from '../common/constants/InteractionConstants';
import { HeaderBarMaterialModifier, makeHeaderBarModifier } from '../utils/HeaderBarMaterial';
import { ArrayDataSource } from '../utils/ArrayDataSource';
import { STORE_LIBRARY_REV, STORE_SAFE_BOTTOM, STORE_SAFE_TOP } from '../common/Constants';
import { BreakpointConstants } from '../common/constants/BreakpointConstants';
import { showAppToast } from '../components/AppToast';

/**
 * 「拉取新投稿」每次最多收多少条。
 * ⚠️ 放在 import 之后 —— ArkTS 不允许 import 出现在其它语句之后（arkts-no-misplaced-imports）。
 */
const UP_REFRESH_MAX_ITEMS: number = 60;

@Component
export struct PlaylistDetail {
  /**
   * 自绘标题栏的沉浸材质修饰器（THIN 毛玻璃，共享件）：
   * systemMaterial 属性方法 26.0.0 才有，低版本 / 能力缺失时修饰器
   * 兜底 bg_page 实底（见 utils/HeaderBarMaterial.ets）。
   */
  private headerModifier: HeaderBarMaterialModifier = makeHeaderBarModifier();
  @State playlist: Playlist | null = null;
  @State titleText: string = '歌单';
  /** 「拉取新投稿」进行中：防止连点重复发请求 */
  @State upRefreshing: boolean = false;
  /** 媒体库变更信号：在别处（如弹层里）改到这个歌单时同步刷新 */
  @StorageLink(STORE_LIBRARY_REV) @Watch('onLibraryChanged') libraryRev: number = 0;
  /** 状态栏高度（vp）：标题栏要整体落在状态栏下方，由本页自己顶下来 */
  @StorageLink(STORE_SAFE_TOP) safeTop: number = 0;
  /** 底部安全区高度（vp）：NavDestination 默认扩到屏幕底，列表末尾要自己让开手势区 */
  @StorageLink(STORE_SAFE_BOTTOM) safeBottom: number = 0;
  /** 当前断点（Index 常驻注册写入）：大屏上内容列收窄居中 */
  @StorageProp(BreakpointConstants.CURRENT_BREAKPOINT) currentBreakpoint: string = BreakpointConstants.BREAKPOINT_SM;
  private player: MusicPlayer = MusicPlayer.getInstance();

  /**
   * 列表数据源：歌单可能积累上百首，LazyForEach 只构建可视区 + 缓存区节点，
   * 首屏不再一次性建全部行。整表替换走 reload()（load() 内）。
   */
  private trackSource: ArrayDataSource<Track> = new ArrayDataSource<Track>([]);

  /**
   * 子页转场的横移量（相对页面自身宽度）：常驻 '0%'，
   * 转场代理里按 push/pop 方向临时改写（见 navTransitionDelegate）。
   */
  @State navTransX: string = '0%';

  /**
   * 头部区展示用的派生字段（load() 时重算）：@Builder 体内不放局部声明、
   * 也不便反复对 playlist 判空，元信息 / 封面 / 简介统一在 load() 算好成串。
   */
  @State coverUrl: string = '';
  @State metaText: string = '';
  @State descText: string = '';

  aboutToAppear(): void {
    this.load();
  }

  /**
   * 子页转场（customTransition 代理）：从右滑入 slow(400ms) EaseOut。
   * · push 入场：先把页面挪到屏幕右侧外（'100%'），event 闭包内回到 '0%'，
   *   系统按闭包内的状态变化生成 400ms EaseOut 过渡；
   * · pop 出场（含侧滑返回手势触发的返回）：反向滑回右侧，与手势方向一致；
   * · 其余场景（本页被上层页覆盖 / 上层页返回后重新露出）返回 undefined，
   *   走系统默认转场。
   */
  private navTransitionDelegate(op: NavigationOperation,
    isEnter: boolean): Array<NavDestinationTransition> | undefined {
    if (op === NavigationOperation.PUSH && isEnter) {
      this.navTransX = '100%';
      const enter: NavDestinationTransition = {
        duration: NAV_TRANSITION_MS,
        curve: Curve.EaseOut,
        event: (): void => {
          this.navTransX = '0%';
        }
      };
      const transitions: Array<NavDestinationTransition> = [enter];
      return transitions;
    }
    if (op === NavigationOperation.POP && !isEnter) {
      const exit: NavDestinationTransition = {
        duration: NAV_TRANSITION_MS,
        curve: Curve.EaseOut,
        event: (): void => {
          this.navTransX = '100%';
        }
      };
      const transitions: Array<NavDestinationTransition> = [exit];
      return transitions;
    }
    return undefined;
  }

  onLibraryChanged(): void {
    this.load();
  }

  private load(): void {
    const p: Playlist | null = LibraryStore.getPlaylist(NavStackHolder.selectedPlaylistId);
    this.playlist = p;
    this.titleText = p ? p.name : '歌单';
    this.coverUrl = p ? p.coverUrl : '';
    this.descText = p && p.description.length > 0 ? p.description : '';
    this.metaText = this.buildMetaText(p);
    this.trackSource.reload(p ? p.tracks : []);
  }

  /**
   * 头部区元信息行：歌曲数 + 来源。
   * 订阅歌单优先显示 UP 昵称（订阅关系的核心信息）；
   * 普通歌单显示创建日期（取 ISO 串前 10 位，零格式化风险）。
   */
  private buildMetaText(p: Playlist | null): string {
    if (!p) {
      return '';
    }
    const countText: string = `${p.tracks.length} 首`;
    if (p.upMid.length > 0) {
      return p.upName.length > 0 ? `${countText} · 订阅自 ${p.upName}` : countText;
    }
    return p.createdAt.length >= 10 ? `${countText} · 创建于 ${p.createdAt.slice(0, 10)}` : countText;
  }

  private toast(message: string, duration: number): void {
    showAppToast(message, duration);
  }

  /**
   * 拉取该订阅 UP 的新投稿并入歌单（按 id 去重，新的排前面）。
   *
   * 走 `getUserVideosViaSearch`（搜索反查 + 按 mid 过滤）而不是空间接口：
   * 空间接口对匿名访问风控极强（实测同一 URL 连打 8 次 0/8 成功），
   * 而搜索反查稳定、且结果带 `pubdate` 可重排成「最近投稿在前」。
   * 搜索没命中时才退回空间接口兜底。
   */
  private refreshUpTracks(): void {
    const p: Playlist | null = this.playlist;
    if (!p || p.upMid.length === 0 || this.upRefreshing) {
      return;
    }
    this.upRefreshing = true;
    this.toast('正在拉取新投稿…', 1200);
    const name: string = p.upName;
    BilibiliApi.getUserVideosViaSearch(p.upMid, name, UP_REFRESH_MAX_ITEMS)
      .then((r: BilibiliApi.UpVideosSearchResult): Promise<SpaceVideo[]> => {
        if (r.list.length > 0) {
          return Promise.resolve(r.list);
        }
        // 搜索没命中（昵称搜不到）→ 空间接口兜底（带 3 次重试）
        return BilibiliApi.getUserVideosWithRetry(Number(p.upMid), UP_REFRESH_MAX_ITEMS, 'pubdate', 3);
      })
      .then((collected: SpaceVideo[]): void => {
        if (collected.length === 0) {
          this.toast('没有拿到新投稿，稍后再试', 1800);
          return;
        }
        const tracks: Track[] = collected.map((v: SpaceVideo): Track => {
          return buildTrack({
            id: v.bvid,
            bvid: v.bvid,
            aid: String(v.aid ?? 0),
            title: stripHtmlTags(v.title),
            artist: v.author || name,
            upMid: p.upMid,
            coverUrl: toHttpsUrl(v.pic),
            duration: parseDurationText(v.length),
            playCount: v.play ?? 0
          });
        });
        const r = LibraryStore.mergeUpTracks(p.id, tracks);
        this.load();
        if (r.added === 0) {
          this.toast('没有新投稿', 1500);
        } else if (r.dropped > 0) {
          this.toast(`新增 ${r.added} 首，已满 ${r.playlist ? r.playlist.tracks.length : 0} 首`, 2000);
        } else {
          this.toast(`新增 ${r.added} 首`, 1800);
        }
      })
      .catch((e: Error): void => {
        console.error(`refreshUpTracks failed: ${e.message}`);
        this.toast('拉取失败，B 站可能限制了访问', 2000);
      })
      .then((): void => {
        this.upRefreshing = false;
      });
  }

  private showMenu(track: Track): void {
    this.getUIContext().showAlertDialog({
      title: track.title,
      message: '选择操作',
      primaryButton: {
        value: '从歌单移除',
        action: (): void => {
          LibraryStore.removeTracksFromPlaylist(NavStackHolder.selectedPlaylistId, [track.id]);
          this.load();
        }
      },
      secondaryButton: {
        value: '加入队列',
        action: (): void => {
          this.player.addToQueue(track);
          this.toast('已加入播放队列', 1500);
        }
      }
    });
  }

  /**
   * 头部区（列表首个 ListItem，随内容滚出视口）：
   * 左侧 96vp 圆角封面（CoverImage 自带空图 / 失败占位），
   * 右侧 28fp 大标题 + 元信息行 + 可选简介；封面行下方是操作按钮行
   * （播放全部 / 拉取新投稿，均不钉顶）。
   * 数据全部来自 load() 预计算的派生字段（coverUrl / metaText / descText），
   * @Builder 体内不声明局部变量、不对 playlist 判空。
   */
  @Builder
  PlaylistHeader(): void {
    Column() {
      Row() {
        CoverImage({
          url: this.coverUrl,
          imgWidth: 96,
          imgHeight: 96,
          imgRadius: 12,
          altText: this.titleText
        })
        Column() {
          Text(this.titleText)
            .fontSize(28)
            .fontWeight(FontWeight.Bold)
            .fontColor($r('app.color.text_primary'))
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          if (this.metaText.length > 0) {
            Text(this.metaText)
              .fontSize(13)
              .fontColor($r('app.color.text_secondary'))
              .maxLines(1)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
              .margin({ top: 6 })
          }
          if (this.descText.length > 0) {
            Text(this.descText)
              .fontSize(12)
              .fontColor($r('app.color.text_tertiary'))
              .maxLines(2)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
              .margin({ top: 6 })
          }
        }
        .layoutWeight(1)
        .margin({ left: 16 })
        .alignItems(HorizontalAlign.Start)
      }
      .width('100%')
      .alignItems(VerticalAlign.Top)

      // 操作按钮行：随头部区一起滚动（用户明确不要钉在顶部固定栏）。
      // 播放全部：有曲目才显示；拉取新投稿：订阅歌单（upMid 非空）才显示，
      // 空的订阅歌单也保留它 —— 正好是一键填歌单的入口。
      Row({ space: 8 }) {
        if (this.playlist && this.playlist.tracks.length > 0) {
          Button('播放全部', { type: ButtonType.Capsule })
            .fontSize(13)
            .height(32)
            .backgroundColor($r('app.color.bili_pink'))
            .fontColor($r('app.color.brand_on'))
            .onClick((): void => {
              if (this.playlist) {
                this.player.playAll(this.playlist.tracks);
              }
            })
        }
        if (this.playlist && this.playlist.upMid.length > 0) {
          Button(this.upRefreshing ? '正在拉取…' : '拉取新投稿', { type: ButtonType.Capsule })
            .fontSize(13)
            .height(32)
            .backgroundColor($r('app.color.brand_surface'))
            .fontColor($r('app.color.brand_deep'))
            .enabled(!this.upRefreshing)
            .onClick((): void => {
              this.refreshUpTracks();
            })
        }
      }
      .width('100%')
      .margin({ top: 12 })
      .alignItems(VerticalAlign.Center)
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
    .padding({ left: 20, right: 20, top: 12, bottom: 16 })
  }

  build() {
    NavDestination() {
      Stack() {
        Column() {
          if (this.playlist && this.playlist.tracks.length > 0) {
            List() {
              // 头部区占 index 0：不进 LazyForEach（无复用价值，且避免挤占
              // 曲目行的缓存区预算）。LazyForEach 的 index 是数据源内下标（0 起，
              // 对应第一首曲目），TrackItem.entranceIndex 的错峰动画语义不变。
              ListItem() {
                this.PlaylistHeader()
              }
              LazyForEach(
                this.trackSource,
                (t: Track, index: number): void => {
                  ListItem() {
                    TrackItem({
                      track: t,
                      entranceIndex: index,
                      onPlay: (tr: Track): void => {
                        this.player.playNow(tr);
                      },
                      onMore: (tr: Track): void => {
                        this.showMenu(tr);
                      }
                    })
                  }
                },
                (t: Track): string => t.id
              )
            }
            .layoutWeight(1)
          } else {
            Column() {
              if (this.playlist) {
                this.PlaylistHeader()
              }
              Column() {
                Text('歌单还是空的')
                  .fontColor($r('app.color.text_secondary'))
                  .fontSize(16)
                Text('在搜索页点击“⋯”把歌曲加进来吧')
                  .fontColor($r('app.color.text_tertiary'))
                  .fontSize(13)
                  .margin({ top: 8 })
              }
              .layoutWeight(1)
              .justifyContent(FlexAlign.Center)
            }
            .layoutWeight(1)
            .width('100%')
          }
        }
        .width('100%')
        .height('100%')
        .backgroundColor($r('app.color.bg_page'))
        // 自绘标题栏悬浮在内容上方（同原 STACK 透底方案），列表滚动时从材质下透出；
        // 标题栏整体落在状态栏下方：内容先 padding top = safeTop 顶过状态栏，
        // 再 safeAreaPadding top = 标题栏高度，首项不被标题栏盖住。
        .padding({ top: this.safeTop })
        .safeAreaPadding({ top: NAV_TITLE_BAR_HEIGHT, bottom: this.safeBottom })
        // 大屏适配：内容列收窄居中（折叠屏展开 600vp / 平板 720vp），
        // 根 Stack 默认居中对齐，直接给内容列挂上限即可。
        .constraintSize({ maxWidth: BreakpointConstants.contentMaxWidth(this.currentBreakpoint) })

        // 自绘固定栏（去掉返回键，返回走系统侧滑）：position 到状态栏下方，
        // 不再像系统标题栏那样压到状态栏 / 挖孔区域。
        // 栏内不放任何文字（歌单名只在头部区 28fp 大标题显示一次），Row 仅作
        // 材质载体 —— 列表滚动时仍从 THIN 毛玻璃（低版本 bg_page 实底）下透出。
        // 外面包一层与内容列同宽的宿主：position 相对宿主定位，大屏上标题栏
        // 才能与收窄后的列表左右对齐（直接挂 Stack 上会贴屏幕左缘）；
        // hitTestBehavior(None) 让宿主自身不吞点击，栏以下的区域照常点得到列表。
        Column() {
          Row() {
          }
          .width('100%')
          .height(NAV_TITLE_BAR_HEIGHT)
          .position({ x: 0, y: this.safeTop })
          .backgroundColor(Color.Transparent)
          .attributeModifier(this.headerModifier)
        }
        .width('100%')
        .height('100%')
        .constraintSize({ maxWidth: BreakpointConstants.contentMaxWidth(this.currentBreakpoint) })
        .hitTestBehavior(HitTestMode.None)
      }
    }
    .hideTitleBar(true)
    // 子页转场：横移量由转场代理驱动（translate 是视觉变换，不改布局）
    .translate({ x: this.navTransX })
    .customTransition((op: NavigationOperation, isEnter: boolean): Array<NavDestinationTransition> | undefined => {
      return this.navTransitionDelegate(op, isEnter);
    })
  }
}
