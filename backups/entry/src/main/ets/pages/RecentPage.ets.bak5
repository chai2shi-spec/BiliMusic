/**
 * 最近播放页：展示播放历史（最近 50 条）。
 * 历史由 MusicPlayer.loadAndPlay → LibraryStore.addRecentTrack 自动写入，
 * 这里只负责展示与回放：播放全部 / 单曲播放 / 加入队列 / 单条移除 / 清空。
 *
 * 固定栏为悬浮材质栏（与歌单详情页同款）：THIN 毛玻璃、低版本 bg_page 实底兜底。
 * 双行钉顶：行1「最近播放」小标题常显；行2「播放全部 / 清空」按钮行
 * （仅在有播放记录时渲染），不随内容滚出视口。
 */

import { Track } from '../model/MusicModels';
import { LibraryStore } from '../service/LibraryStore';
import { MusicPlayer } from '../player/MusicPlayer';
import { TrackItem } from '../components/TrackItem';
import { NAV_TITLE_BAR_HEIGHT } from '../utils/NavTitleStyle';
import {
  HeaderBarMaterialModifier,
  makeHeaderBarModifier,
  ButtonMaterialModifier,
  makeButtonMaterialModifier
} from '../utils/HeaderBarMaterial';
import { ArrayDataSource } from '../utils/ArrayDataSource';
import { STORE_LIBRARY_REV, STORE_SAFE_BOTTOM, STORE_SAFE_TOP } from '../common/Constants';
import { BreakpointConstants } from '../common/constants/BreakpointConstants';
import { NAV_TRANSITION_MS, BUTTON_RADIUS_VP } from '../common/constants/InteractionConstants';
import { showAppToast } from '../components/AppToast';

@Component
export struct RecentPage {
  @State tracks: Track[] = [];
  /** 钉顶栏实测高度（vp）：行1 标题 56 + 行2 按钮行 44，内容层 safeAreaPadding 用；默认 100 仅首帧估计 */
  @State barHeight: number = 100;
  /**
   * 媒体库版本号：Storage 的写入是异步落盘，若本页在写入完成前就渲染过，
   * 只靠 aboutToAppear 那一次读取会一直停在空态。订阅版本号后，
   * 任何播放记录变更（新增 / 删除 / 清空）都会把本页重新拉一次。
   */
  @StorageLink(STORE_LIBRARY_REV) @Watch('onLibraryChanged') libraryRev: number = 0;
  /** 状态栏高度（vp）：标题栏要整体落在状态栏下方，由本页自己顶下来 */
  @StorageLink(STORE_SAFE_TOP) safeTop: number = 0;
  /** 底部安全区高度（vp）：NavDestination 默认扩到屏幕底，列表末尾要自己让开手势区 */
  @StorageLink(STORE_SAFE_BOTTOM) safeBottom: number = 0;
  /** 当前断点（Index 常驻注册写入）：大屏上内容列收窄居中 */
  @StorageProp(BreakpointConstants.CURRENT_BREAKPOINT) currentBreakpoint: string = BreakpointConstants.BREAKPOINT_SM;
  private player: MusicPlayer = MusicPlayer.getInstance();

  /** 固定栏沉浸材质修饰器（THIN 毛玻璃，低版本实底兜底，见 utils/HeaderBarMaterial.ets） */
  private headerModifier: HeaderBarMaterialModifier = makeHeaderBarModifier();
  /** 按钮（播放全部 / 清空）沉浸光感材质修饰器：26+ 生效，低版本 no-op 显实色兜底 */
  private buttonMaterial: ButtonMaterialModifier = makeButtonMaterialModifier();

  /**
   * 列表数据源：与 @State tracks 同步（refresh() 内一起写）。
   * LazyForEach 只构建可视区 + 缓存区节点；所有数据变更统一走 refresh() 整表重载。
   */
  private trackSource: ArrayDataSource<Track> = new ArrayDataSource<Track>([]);

  /**
   * 子页转场的横移量（相对页面自身宽度）：常驻 '0%'，
   * 转场代理里按 push/pop 方向临时改写（见 navTransitionDelegate）。
   */
  @State navTransX: string = '0%';

  aboutToAppear(): void {
    this.refresh();
  }

  /**
   * 子页转场（customTransition 代理）：从右滑入 slow(400ms) EaseOut。
   * · push 入场：先把页面挪到屏幕右侧外（'100%'），event 闭包内回到 '0%'，
   *   系统按闭包内的状态变化生成 400ms EaseOut 过渡；
   * · pop 出场（含侧滑返回手势触发的返回）：反向滑回右侧，与手势方向一致；
   * · 其余场景（本页被上层页覆盖 / 上层页返回后重新露出）返回 undefined，
   *   走系统默认转场。
   */
  private navTransitionDelegate(op: NavigationOperation,
    isEnter: boolean): Array<NavDestinationTransition> | undefined {
    if (op === NavigationOperation.PUSH && isEnter) {
      this.navTransX = '100%';
      const enter: NavDestinationTransition = {
        duration: NAV_TRANSITION_MS,
        curve: Curve.EaseOut,
        event: (): void => {
          this.navTransX = '0%';
        }
      };
      const transitions: Array<NavDestinationTransition> = [enter];
      return transitions;
    }
    if (op === NavigationOperation.POP && !isEnter) {
      const exit: NavDestinationTransition = {
        duration: NAV_TRANSITION_MS,
        curve: Curve.EaseOut,
        event: (): void => {
          this.navTransX = '100%';
        }
      };
      const transitions: Array<NavDestinationTransition> = [exit];
      return transitions;
    }
    return undefined;
  }

  onLibraryChanged(): void {
    this.refresh();
  }

  private refresh(): void {
    const list: Track[] = LibraryStore.getRecentTracks();
    console.info(`recent page refresh: ${list.length} tracks`);
    this.tracks = list;
    this.trackSource.reload(list);
  }

  private toast(message: string, duration: number): void {
    showAppToast(message, duration);
  }

  private showMenu(track: Track): void {
    this.getUIContext().showAlertDialog({
      title: track.title,
      message: '选择操作',
      primaryButton: {
        value: '加入队列',
        action: (): void => {
          this.player.addToQueue(track);
          this.toast('已加入播放队列', 1500);
        }
      },
      secondaryButton: {
        value: '从记录移除',
        action: (): void => {
          LibraryStore.removeRecentTrack(track.id);
          // 统一走 refresh()：@State 与 LazyForEach 数据源必须一起换，
          // 只改 this.tracks 会出现「空态判断已更新、列表还停着旧数据」
          this.refresh();
        }
      }
    });
  }

  private clearAll(): void {
    this.getUIContext().showAlertDialog({
      title: '清空播放记录',
      message: '确定清空全部播放记录？此操作不可恢复。',
      primaryButton: {
        value: '取消',
        action: (): void => {
          // 取消：不做任何事
        }
      },
      secondaryButton: {
        value: '清空',
        action: (): void => {
          LibraryStore.clearRecentTracks();
          this.refresh();
          this.toast('已清空播放记录', 1500);
        }
      }
    });
  }

  build() {
    NavDestination() {
      Stack() {
        // 内容层：播放全部 / 清空 钉在固定栏第二行，列表只装曲目行
        Column() {
          if (this.tracks.length > 0) {
            List() {
              LazyForEach(
                this.trackSource,
                (t: Track, index: number): void => {
                  ListItem() {
                    TrackItem({
                      track: t,
                      entranceIndex: index,
                      onPlay: (tr: Track): void => {
                        this.player.playOrToggle(tr);
                      },
                      onMore: (tr: Track): void => {
                        this.showMenu(tr);
                      }
                    })
                  }
                },
                (t: Track): string => t.id
              )
            }
            .layoutWeight(1)
          } else {
            Column() {
              Text('还没有播放记录')
                .fontColor($r('app.color.text_secondary'))
                .fontSize(16)
              Text('去搜索页播放一首歌试试吧')
                .fontColor($r('app.color.text_tertiary'))
                .fontSize(13)
                .margin({ top: 8 })
            }
            .layoutWeight(1)
            .justifyContent(FlexAlign.Center)
          }
        }
        .width('100%')
        .height('100%')
        .backgroundColor($r('app.color.bg_page'))
        // 自绘固定栏悬浮在内容上方（列表滚动时从材质下透出）：
        // 内容先 padding top = safeTop 顶过状态栏，再 safeAreaPadding top = 钉顶栏实测高度。
        .padding({ top: this.safeTop })
        .safeAreaPadding({ top: this.barHeight, bottom: this.safeBottom })
        // 大屏适配：内容列收窄居中（折叠屏展开 600vp / 平板 720vp），
        // 根 Stack 默认居中对齐，直接给内容列挂上限即可。
        .constraintSize({ maxWidth: BreakpointConstants.contentMaxWidth(this.currentBreakpoint) })

        // 自绘固定栏（歌单详情页同款）：position 到状态栏下方，THIN 材质 / 低版本实底。
        // 双行钉顶：行1 小标题常显；行2 播放全部 / 清空（仅在有记录时渲染）。
        // 栏高 = 56 + 4 + 32 + 8 随行2有无浮动，onAreaChange 实测回写 barHeight。
        // 宿主全尺寸 + HitTestMode.None：栏以外的空白不挡列表滚动 / 点击。
        Column() {
          // 修饰器挂在这层 Row 上（材质修饰器是 AttributeModifier<RowAttribute>，
          // DownloadsPage / SearchPage 双行固定栏同款中间层模式）
          Row() {
            Column() {
              Row() {
                Text('最近播放')
                  .fontSize(20)
                  .fontWeight(FontWeight.Bold)
                  .fontColor($r('app.color.text_primary'))
                  .maxLines(1)
                  .textOverflow({ overflow: TextOverflow.Ellipsis })
                  .layoutWeight(1)
              }
              .width('100%')
              .height(NAV_TITLE_BAR_HEIGHT)
              .padding({ left: 20, right: 16 })
              .alignItems(VerticalAlign.Center)
              if (this.tracks.length > 0) {
                Row() {
                  Button('播放全部', { type: ButtonType.Normal })
                    .fontSize(13)
                    .height(32)
                    .borderRadius(BUTTON_RADIUS_VP)
                    .backgroundColor($r('app.color.bili_pink'))
                    .fontColor($r('app.color.brand_on'))
                    .attributeModifier(this.buttonMaterial)
                    .onClick((): void => {
                      this.player.playAll(this.tracks);
                    })
                  Button('清空', { type: ButtonType.Normal })
                    .fontSize(13)
                    .height(32)
                    .borderRadius(BUTTON_RADIUS_VP)
                    .backgroundColor($r('app.color.brand_surface'))
                    .fontColor($r('app.color.brand_deep'))
                    .attributeModifier(this.buttonMaterial)
                    .margin({ left: 12 })
                    .onClick((): void => {
                      this.clearAll();
                    })
                }
                .width('100%')
                .padding({ left: 16, right: 16, top: 4, bottom: 8 })
                .alignItems(VerticalAlign.Center)
              }
            }
            .width('100%')
          }
          .width('100%')
          .position({ x: 0, y: this.safeTop })
          .backgroundColor(Color.Transparent)
          .attributeModifier(this.headerModifier)
          .onAreaChange((_old: Area, cur: Area): void => {
            const h: number = cur.height as number;
            if (h > 0) {
              this.barHeight = h;
            }
          })
        }
        .width('100%')
        .height('100%')
        .constraintSize({ maxWidth: BreakpointConstants.contentMaxWidth(this.currentBreakpoint) })
        .hitTestBehavior(HitTestMode.None)
      }
    }
    .hideTitleBar(true)
    // 子页转场：横移量由转场代理驱动（translate 是视觉变换，不改布局）
    .translate({ x: this.navTransX })
    .customTransition((op: NavigationOperation, isEnter: boolean): Array<NavDestinationTransition> | undefined => {
      return this.navTransitionDelegate(op, isEnter);
    })
  }
}
