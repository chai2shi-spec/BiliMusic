/**
 * HDS 标题栏沉浸光感样式助手（HdsNavigation 迁移批 1 建立，批 2 各子页复用）。
 *
 * 职责：把「沉浸材质 + 滚动模糊 + 温控 + 兜底」收敛到一处，所有迁移到
 * HdsNavDestination.titleBar 的页面统一从这里取 TitleBarStyleOptions，
 * 保证全站顶栏与底部悬浮胶囊（Index.barFloatingStyle）材质观感一致。
 *
 * 两条路径（批 0 静态分析结论，SDK：@hms.hds.hdsBaseComponent.d.ets）：
 * - **主路径**（设备支持 IMMERSIVE 沉浸材质，MaterialCompat.supportsImmersiveMaterial() 探测）：
 *   systemMaterialEffect = { materialType: IMMERSIVE, materialLevel: EXQUISITE }
 *   + scrollEffectType: IMMERSIVE_GRADIENT_BLUR（默认 56vp 内完成样式过渡）
 *   + thermoCtrl: true（温控让路，发热时自动降档）。
 * - **兜底路径**（不支持 / 探测异常）：不用 systemMaterialEffect（会静默不渲染材质，
 *   退化成纯色），改走 GRADIENT_BLUR + backgroundStyle.blurRadius 近似旧
 *   GlassTopBar 的 backgroundEffect 毛玻璃。
 *   ⚠️ HdsNavigationBackgroundStyle.blurRadius 仅在 GRADIENT_BLUR / IMMERSIVE_GRADIENT_BLUR
 *   模式下生效（SDK :1100 注释），COMMON_BLUR 下会被忽略 —— 兜底必须选 GRADIENT_BLUR。
 *   backgroundStyle 无 saturation / brightness / lightColor 字段，只能做近似。
 *
 * 不加品牌粉光晕（任务书问题 2 结论：2026-10-06 真机观感显脏已整层删除；
 * HdsNavigationBackgroundStyle 本就无 lightColor 字段）。
 *
 * ⚠️ 滚动过渡必须有「样式端点」（2026-10-09 排查「模糊未生效」后补，两档同时修）：
 * scrollEffectOpts 的 [start, end] 区间是对标题栏样式做**线性插值**——此前沉浸档
 * 完全没设 originalStyle / scrollEffectStyle、兜底档两端完全相同，插值都没有
 * 「可过渡的属性差异」→ 滚动时看不到任何可见变化。现在：
 * 沉浸档 透明 → blurRadius:40（只磨砂不染色，避免与材质叠加显脏）；
 * 兜底档 弱玻璃(header_glass_tint_weak) → 标准玻璃(header_glass_tint)。
 *
 * ⚠️ 本文件必须是 .ets：HDS 类型只能在 .ets 里 import（.ts 报 10311005）。
 */

import { TitleBarStyleOptions, ScrollEffectOptions, ScrollEffectType, hdsMaterial } from '@kit.UIDesignKit';
import { LengthMetrics } from '@kit.ArkUI';
import { MaterialCompat } from './MaterialCompat';

export class HdsTitleBarStyle {
  /**
   * 生成 HdsNavDestination.titleBar({ style }) 的样式选项。
   *
   * 每次调用都会打一条 [TopBar] 日志（immersive / fallback + 模糊区间），
   * 真机验收时用 `hdc shell hilog | grep TopBar` 检索档位决策。
   *
   * @param blurStartVp 滚动模糊起始偏移（基准口径 = 关于页：「首条内容自静止位上移量」的下限）。
   *   不传 = HDS 默认（0）。
   * @param blurEndVp 滚动模糊完成偏移（上限，不传 = HDS 默认：沉浸档 56 / 兜底档 8）。
   * @param maskExtraVp 模糊蒙层超出标题栏的额外高度（vp）。⚠️ 仅兜底档 GRADIENT_BLUR
   *   生效（官方文档：maskExtraHeight 只在 GRADIENT_BLUR 模式下生效，沉浸档
   *   IMMERSIVE_GRADIENT_BLUR 忽略）。有 bottomBuilder 第二行的页面传第二行高度，
   *   让滚动模糊蒙层罩住整栏（官方 bottomBuilder 示例同款：其值 = bottomBuilder 高度；
   *   默认 32 罩不住较高的第二行）。不传 / ≤0 = HDS 默认 32。
   *
   * （历史记录：曾有过第三/四参 coffsetComp 让位量负补偿，已真机证伪删除——
   * 机制记录见 design/顶栏模糊对齐关于页-其余页面任务书.md §2/§5。）
   */
  static styleOptions(blurStartVp?: number, blurEndVp?: number, maskExtraVp?: number): TitleBarStyleOptions {
    const immersive: boolean = MaterialCompat.supportsImmersiveMaterial();
    const startNum: number | undefined = blurStartVp;
    const endNum: number | undefined = blurEndVp;
    // 两档共用同一份 scrollEffectOpts：滚动模糊时机与材质档位解耦，
    // 保证兜底档与沉浸档「起糊 / 显影」时机一致，只有材质厚度不同。
    const opts: ScrollEffectOptions = {
      enableScrollEffect: true,
      scrollEffectType: immersive
        ? ScrollEffectType.IMMERSIVE_GRADIENT_BLUR
        : ScrollEffectType.GRADIENT_BLUR
    };
    if (startNum !== undefined) {
      opts.blurEffectiveStartOffset = LengthMetrics.vp(startNum);
    }
    if (endNum !== undefined) {
      opts.blurEffectiveEndOffset = LengthMetrics.vp(endNum);
    }
    // 日志打补偿后的值：真机用 `hdc shell hilog | grep TopBar` 核对补偿是否生效
    const startText: string = startNum !== undefined ? `${startNum}` : 'default';
    const endText: string = endNum !== undefined ? `${endNum}` : 'default';
    if (immersive) {
      console.info(`[TopBar] material=immersive level=EXQUISITE effect=IMMERSIVE_GRADIENT_BLUR blurStart=${startText} blurEnd=${endText}`);
      return {
        scrollEffectOpts: opts,
        thermoCtrl: true,
        // 滚动前：完全透明（官方示例同款起点）。
        // ⚠️ 这两个端点是「滚动可见变化」的必要条件：没有它们，[start, end] 区间
        // 没有可插值的属性差异，滚动时看不出任何变化（2026-10-09「模糊未生效」根因）。
        originalStyle: {
          backgroundStyle: {
            backgroundColor: Color.Transparent
          }
        },
        // 滚动后：只加模糊半径、不染色 —— 磨砂由 blurRadius 承担，避免自绘底色
        // 与沉浸材质叠加显脏（2026-10-06 粉色底纹真机显脏的教训）。
        // blurRadius 仅在 GRADIENT_BLUR / IMMERSIVE_GRADIENT_BLUR 模式生效（SDK 原文）。
        scrollEffectStyle: {
          backgroundStyle: {
            blurRadius: 40
          }
        },
        systemMaterialEffect: {
          materialType: hdsMaterial.MaterialType.IMMERSIVE,
          materialLevel: hdsMaterial.MaterialLevel.EXQUISITE
        }
      };
    }
    // 兜底：GRADIENT_BLUR 滚动模糊 + 半透明玻璃底色 + blurRadius 近似旧 backgroundEffect。
    // 起点用「弱玻璃」（几乎透明、有一点底色，官方博客防闪烁口径），终点是标准玻璃色——
    // ⚠️ 修复（2026-10-09）：此前两端都用 header_glass_tint，样式零差异 → 滚动无动态。
    // maskExtraHeight：模糊蒙层额外高度，两端同值避免插值时蒙层伸缩
    const maskNum: number = maskExtraVp !== undefined && maskExtraVp > 0 ? maskExtraVp : 32;
    console.info(`[TopBar] material=fallback effect=GRADIENT_BLUR blurRadius=40 blurStart=${startText} blurEnd=${endText} mask=${maskNum}`);
    return {
      scrollEffectOpts: opts,
      thermoCtrl: true,
      originalStyle: {
        backgroundStyle: {
          backgroundColor: $r('app.color.header_glass_tint_weak'),
          blurRadius: 40,
          maskExtraHeight: maskNum
        }
      },
      scrollEffectStyle: {
        backgroundStyle: {
          backgroundColor: $r('app.color.header_glass_tint'),
          blurRadius: 40,
          maskExtraHeight: maskNum
        }
      }
    };
  }
}
