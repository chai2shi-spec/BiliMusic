{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": ["arm64-v8a"]
    },
    // 手动创建的 Worker 线程文件必须在此注册，否则不会打包进 HAP，
    // 运行时报「The worker file path is invalid, can't find the file」。
    // 路径规则：写法一 {moduleName}/ets/{src/main/ets 下相对路径}.ets。
    "sourceOption": {
      "workers": [
        "./src/main/ets/service/asr/AsrRecognizeWorker.ets"
      ]
    },
    // sherpa_onnx HAR 自带 x86_64 四个 so（onnxruntime 等，未压缩约 21MB），
    // 仅 x86 模拟器可用；真机为 arm64，排除后 HAP 减小约 14MB（压缩后）。
    "napiLibFilterOption": {
      "excludes": [
        "**/x86_64/**.so"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false
          },
          "consumerFiles": []
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    // ohosTest：Instrument Test（hypium 单元测试）编译目标，源码在 entry/src/ohosTest。
    // hvigor 按 entry@ohosTest 单独出测试 HAP，不影响 default 目标产物。
    {
      "name": "ohosTest"
    }
  ]
}
